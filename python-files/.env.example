
# توکن ربات تلگرام
TELEGRAM_TOKEN=

# از https://my.telegram.org بگیرید
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# شماره تلگرام یوزراکانت، با کد کشور (مثال: 989123456789)
TELEGRAM_PHONE=

# آیدی عددی تلگرام شما — فقط همین کاربر اجازه‌ی استفاده از ربات رو داره.
# برای گرفتنش به @userinfobot پیام بده.
ALLOWED_USER_ID=

# ─── اختیاری ───────────────────────────────────────────────
# MAX_SIZE_MB=2000          # سقف حجم هر فایل
# ARCHIVE_PASSWORD=          # رمز ثابت آرشیو (حداقل ۱۲ کاراکتر)؛ توی کپشن نوشته نمی‌شه. خالی = رمز رندوم توی کپشن
# MIN_FREE_MB=300           # حداقل فضای خالی دیسک
# DOWNLOAD_DIR=
# COOKIES_FILE=/path/to/cookies.txt   # کوکی Netscape برای اینستاگرام/یوتیوب
# PROXY=socks5://127.0.0.1:1080
# JS_RUNTIME=node           # برای یوتیوب؛ خالی = تشخیص خودکار deno/node
# GALLERY_MAX_FILES=20      # سقف فایل‌های یک لینک گالری
