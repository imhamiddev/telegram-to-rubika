# این فایل رو کپی کن به .env و مقادیر واقعی رو جایگزین کن:
#   cp .env.example .env

# توکن ربات تلگرام (از @BotFather)
TELEGRAM_TOKEN=

# از https://my.telegram.org بگیرید
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# شماره تلگرام یوزراکانت، با کد کشور (مثال: 989123456789)
TELEGRAM_PHONE=

# آیدی عددی تلگرام شما — فقط همین کاربر اجازه‌ی استفاده از ربات رو داره.
# برای گرفتنش به @userinfobot پیام بده.
ALLOWED_USER_ID=
